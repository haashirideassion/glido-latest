DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-secret-key-minimum-32-characters-long
JWT_EXPIRATION=24h
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Stripe — card payments
# Each tenant connects their OWN Stripe account, so there is no global Stripe key
# here. A tenant's secret key, publishable key, and webhook signing secret all live
# on that tenant's row (tenants.stripe_secret_key / stripe_public_key /
# stripe_webhook_secret), set from Settings > Stripe on the reception portal.
#
# For local dev, run:
#   stripe listen --events checkout.session.completed,checkout.session.expired,charge.refunded --forward-to localhost:3001/api/payments/webhook/<tenant-id>
# and paste the whsec_... value it prints into that tenant's Webhook Secret field
# in Settings. In production, each tenant registers their own webhook endpoint in
# their own Stripe Dashboard under Developers > Webhooks, pointing at
# https://<your-backend-domain>/api/payments/webhook/<tenant-id>.
#
# Stripe redirects the customer back to the first FRONTEND_ORIGIN above, so in
# production set FRONTEND_ORIGIN to the public frontend URL.
