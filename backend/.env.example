DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-secret-key-minimum-32-characters-long
JWT_EXPIRATION=24h
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud Storage — media (PDFs, images, etc)
GCS_BUCKET_NAME=glido-media-prod
# No key file needed in production: the backend runs on GCP compute (Cloud Run)
# with glido-prod-serviceaccount-user@project-1ba85b8a-f9aa-4995-9cb8.iam.gserviceaccount.com
# attached as its runtime identity — Application Default Credentials picks it up
# automatically from the metadata server.
#
# For LOCAL DEV ONLY, run `gcloud auth application-default login` once and leave
# GOOGLE_APPLICATION_CREDENTIALS unset.
